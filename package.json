{
  "name": "symphony",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "symphony": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "doctor": "tsx src/cli.ts doctor",
    "dev": "tsx src/cli.ts",
    "extension:build": "npm run build --prefix extension",
    "extension:ci": "npm ci --prefix extension",
    "extension:test": "npm run test --prefix extension",
    "extension:typecheck": "npm run typecheck --prefix extension",
    "smoke:active-context-governor": "tsx scripts/active-context-governor-poc.ts",
    "smoke:hermes-local": "tsx scripts/hermes-local-smoke.ts",
    "smoke:mcp-exposure": "tsx scripts/mcp-tool-exposure-probe.ts",
    "smoke:sdk-local": "tsx scripts/sdk-local-smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.12",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "liquidjs": "^10.25.7",
    "yaml": "^2.8.4",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
