{
  "name": "symphony-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "smoke:browser-harness": "node scripts/browser-smoke.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:browser": "node scripts/browser-vite-proxy-smoke.mjs",
    "smoke:browser-production": "node scripts/browser-vite-proxy-smoke.mjs --production"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.7"
  }
}
